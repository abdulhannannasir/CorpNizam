# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose to the browser — Postgres Row Level Security
# (see supabase/migrations/0001_init.sql) is what actually enforces access control.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is ONLY needed for admin scripts (e.g. seeding compliance_rules
# reference data) run outside the app. Never import this in any file reachable
# from the browser, and never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=
